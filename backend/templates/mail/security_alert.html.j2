<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Security alert</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f4f4f5; font-family:'Segoe UI', Helvetica, Arial, sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
      Your Panic Button account {{ change_label }} was changed. If this wasn't you, secure your account now.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.08);">

            <tr>
              <td style="background-color:#EA2052; padding:28px 32px; text-align:center;">
                <span style="color:#ffffff; font-size:20px; font-weight:700; letter-spacing:0.5px;">
                  PANIC BUTTON
                </span>
              </td>
            </tr>

            <tr>
              <td style="padding:36px 32px 8px 32px;">
                <p style="margin:0 0 16px 0; font-size:16px; color:#27272a;">Hi {{ user_name }},</p>
                <p style="margin:0 0 16px 0; font-size:16px; line-height:1.6; color:#3f3f46;">
                  Your Panic Button account <strong>{{ change_label }}</strong> was just changed on
                  <strong>{{ timestamp }}</strong>.
                </p>
                <p style="margin:0 0 16px 0; font-size:16px; line-height:1.6; color:#3f3f46;">
                  If this was you, no action is needed.
                </p>
                <p style="margin:0 0 16px 0; font-size:16px; line-height:1.6; color:#3f3f46;">
                  If it wasn't you, someone may have access to your account — change your password
                  immediately and contact us at
                  <a href="mailto:{{ contact_email }}" style="color:#EA2052;">{{ contact_email }}</a>.
                </p>
              </td>
            </tr>

            <tr>
              <td style="background-color:#fafafa; padding:20px 32px; text-align:center;">
                <p style="margin:0; font-size:11px; color:#a1a1aa;">
                  Panic Button &middot; Emergency alert system
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
