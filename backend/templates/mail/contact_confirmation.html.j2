<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Confirm emergency contact</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f4f4f5; font-family:'Segoe UI', Helvetica, Arial, sans-serif;">
    <div style="display:none; max-height:0; overflow:hidden; opacity:0;">
      {{ user_name }} added you as an emergency contact on PanicSwitch — confirm to start receiving alerts.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f5; padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.08);">

            <tr>
              <td style="background-color:#991b1b; padding:28px 32px; text-align:center;">
                <span style="font-size:28px; vertical-align:middle;">🆘</span>
                <span style="color:#ffffff; font-size:20px; font-weight:700; letter-spacing:0.5px; vertical-align:middle; margin-left:8px;">
                  PanicSwitch
                </span>
              </td>
            </tr>

            <tr>
              <td style="padding:36px 32px 8px 32px;">
                <p style="margin:0 0 16px 0; font-size:16px; color:#27272a;">Hi {{ contact_name }},</p>
                <p style="margin:0 0 16px 0; font-size:16px; line-height:1.6; color:#3f3f46;">
                  <strong>{{ user_name }}</strong> added you as an emergency contact on PanicSwitch.
                  If they ever trigger a panic alert, you'll be notified right away so you can help.
                </p>
                <p style="margin:0 0 28px 0; font-size:16px; line-height:1.6; color:#3f3f46;">
                  Please confirm that you agree to receive those alerts:
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:0 32px 32px 32px; text-align:center;">
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;">
                  <tr>
                    <td style="border-radius:8px; background-color:#dc2626;">
                      <a href="{{ confirmation_url }}"
                         style="display:inline-block; padding:14px 36px; font-size:16px; font-weight:700; color:#ffffff; text-decoration:none; border-radius:8px;">
                        Confirm Emergency Contact
                      </a>
                    </td>
                  </tr>
                </table>
                <p style="margin:20px 0 0 0; font-size:12px; color:#a1a1aa;">
                  Or copy this link into your browser:<br />
                  <a href="{{ confirmation_url }}" style="color:#dc2626; word-break:break-all;">{{ confirmation_url }}</a>
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:0 32px 32px 32px; border-top:1px solid #f4f4f5;">
                <p style="margin:24px 0 0 0; font-size:13px; color:#a1a1aa; line-height:1.5;">
                  If you don't know this person, you can safely ignore this email — no alert will be sent to you.
                </p>
              </td>
            </tr>

            <tr>
              <td style="background-color:#fafafa; padding:20px 32px; text-align:center;">
                <p style="margin:0; font-size:11px; color:#a1a1aa;">
                  PanicSwitch &middot; Emergency alert system
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
