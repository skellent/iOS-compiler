<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset your password — Panic Button</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/static/img/favicon.png" />
    <link rel="stylesheet" href="/static/css/confirmation_result.css" />
    <style>
      .reset-form { display: flex; flex-direction: column; gap: 14px; margin: 8px 0 4px; text-align: left; }
      .reset-form label { font-size: 12px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #71717a; margin-bottom: 6px; display: block; }
      .reset-form input { width: 100%; box-sizing: border-box; border: 1.5px solid #e4e4e7; border-radius: 10px; padding: 12px 13px; font-size: 15px; font-family: inherit; }
      .reset-form input:focus { outline: none; border-color: #EA2052; box-shadow: 0 0 0 4px rgba(234,32,82,0.15); }
      .reset-btn { border: none; border-radius: 10px; padding: 13px 20px; font-size: 15px; font-weight: 700; color: #fff; background: #EA2052; cursor: pointer; margin-top: 4px; }
      .reset-btn:disabled { opacity: 0.6; cursor: default; }
      .reset-msg { font-size: 14px; margin: 4px 0 0; min-height: 18px; }
      .reset-msg.error { color: #EA2052; }
      .reset-msg.ok { color: #16a34a; }
      .reset-hint { font-size: 12px; color: #a1a1aa; margin: 0; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Reset your password</h1>
      <p class="message">Choose a new password for your Panic Button account.</p>

      <form class="reset-form" id="reset-form" novalidate>
        <div>
          <label for="password">New password</label>
          <input type="password" id="password" autocomplete="new-password" minlength="8" required />
        </div>
        <div>
          <label for="confirm">Confirm new password</label>
          <input type="password" id="confirm" autocomplete="new-password" minlength="8" required />
        </div>
        <p class="reset-hint">At least 8 characters.</p>
        <button type="submit" class="reset-btn" id="submit-btn">Set new password</button>
        <p class="reset-msg" id="msg"></p>
      </form>

      <span class="brand">PANIC BUTTON</span>
      <p class="footnote">Emergency alert system</p>
    </div>

    <script>
      (function () {
        var form = document.getElementById("reset-form");
        var msg = document.getElementById("msg");
        var btn = document.getElementById("submit-btn");
        var url = "/auth/password-reset/{{ reset_token }}";

        form.addEventListener("submit", async function (event) {
          event.preventDefault();
          var password = document.getElementById("password").value;
          var confirm = document.getElementById("confirm").value;
          msg.className = "reset-msg";
          msg.textContent = "";

          if (password.length < 8) {
            msg.className = "reset-msg error";
            msg.textContent = "Password must be at least 8 characters.";
            return;
          }
          if (password !== confirm) {
            msg.className = "reset-msg error";
            msg.textContent = "The passwords don't match.";
            return;
          }

          btn.disabled = true;
          try {
            var response = await fetch(url, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ password: password }),
            });
            if (response.ok) {
              form.reset();
              msg.className = "reset-msg ok";
              msg.textContent = "Password updated. Open the Panic Button app and log in with your new password.";
              btn.textContent = "Done";
            } else {
              var body = await response.json().catch(function () { return {}; });
              msg.className = "reset-msg error";
              msg.textContent = typeof body.detail === "string" ? body.detail : "This reset link is invalid or has expired.";
              btn.disabled = false;
            }
          } catch (err) {
            msg.className = "reset-msg error";
            msg.textContent = "Something went wrong. Please try again.";
            btn.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
