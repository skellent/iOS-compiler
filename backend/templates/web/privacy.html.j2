      <article class="legal" data-lang="en">
        <div class="legal-head">
          <h1>Privacy Policy</h1>
          <p class="legal-updated">Last updated: {{ updated_en }}</p>

          <dl class="legal-meta">
            <div class="legal-meta-item">
              <dt>Data controller</dt>
              <dd>{{ company_name }}</dd>
            </div>
            <div class="legal-meta-item">
              <dt>Application</dt>
              <dd>Panic Button (com.keycodelogics.panicbutton)</dd>
            </div>
            <div class="legal-meta-item">
              <dt>Contact email</dt>
              <dd><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></dd>
            </div>
            <div class="legal-meta-item">
