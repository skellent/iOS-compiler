<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard — Panic Switch</title>
    <link rel="icon" type="image/png" href="data:image/png;base64," />
    <style>
      :root {
        --bg-950: #050408;
        --bg-900: #0b0a10;
        --bg-800: #131019;
        --surface: rgba(255, 255, 255, 0.045);
        --surface-2: rgba(255, 255, 255, 0.075);
        --line: rgba(255, 255, 255, 0.09);
        --line-strong: rgba(255, 255, 255, 0.18);
        --primary-900: #8c1331;
        --primary-700: #c71b46;
        --primary-600: #dd1e4d;
        --primary-500: #ea2052;
        --primary-400: #ff4d75;
        --text-000: #ffffff;
        --text-100: #f2f0f5;
        --text-300: #c6c2cf;
        --text-500: #8e8a99;
        --radius: 16px;
        --radius-sm: 11px;
        --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --font-mono: ui-monospace, "SFMono-Regular", "Roboto Mono", Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: var(--font);
        color: var(--text-100);
        background:
          radial-gradient(circle at 12% -6%, rgba(234, 32, 82, 0.22), transparent 42%),
          radial-gradient(circle at 92% 14%, rgba(175, 24, 61, 0.18), transparent 38%),
          var(--bg-900);
      }
      .wrap {
        max-width: 640px;
        margin: 0 auto;
        padding: 48px 20px 60px 20px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: center;
        margin-bottom: 32px;
      }
      .brand-mark {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: radial-gradient(circle at 35% 30%, var(--primary-500), var(--primary-900));
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 900;
        font-size: 11px;
        letter-spacing: 0.5px;
        box-shadow: 0 6px 18px rgba(234, 32, 82, 0.4);
      }
      .brand-name {
        font-weight: 800;
        letter-spacing: 0.6px;
        font-size: 15px;
      }

      /* Login card */
      .card {
        max-width: 360px;
        margin: 0 auto;
        background: var(--bg-800);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 32px 28px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      }
      .card h1 {
        margin: 0 0 6px 0;
        font-size: 19px;
        text-align: center;
      }
      .card .subtitle {
        margin: 0 0 24px 0;
        font-size: 13px;
        color: var(--text-500);
        text-align: center;
      }
      .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
      .field label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        color: var(--text-500);
      }
      .field input {
        border: 1.5px solid var(--line);
        border-radius: var(--radius-sm);
        padding: 12px 13px;
        font-size: 14px;
        color: var(--text-100);
        background: var(--surface);
        font-family: inherit;
      }
      .field input:focus {
        outline: none;
        border-color: var(--primary-500);
        box-shadow: 0 0 0 4px rgba(234, 32, 82, 0.18);
      }
      .btn {
        width: 100%;
        border: none;
        border-radius: var(--radius-sm);
        padding: 13px 20px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        cursor: pointer;
        background: linear-gradient(120deg, var(--primary-600), var(--primary-900));
        color: #fff;
        margin-top: 6px;
      }
      .btn-outline {
        background: rgba(234, 32, 82, 0.06);
        color: var(--primary-400);
        border: 1.5px solid var(--primary-700);
        width: auto;
        text-transform: none;
        letter-spacing: normal;
        font-weight: 600;
        padding: 8px 16px;
      }
      .error {
        margin: 0 0 14px 0;
        font-size: 13px;
        color: var(--primary-400);
        text-align: center;
      }

      /* Dashboard */
      .dash-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
      }
      .dash-header h1 { margin: 0; font-size: 18px; }
      .empty { color: var(--text-500); font-size: 14px; text-align: center; padding: 40px 0; }

      .alert-card {
        background: var(--bg-800);
        border: 1px solid var(--line);
        border-left: 3px solid var(--primary-700);
        border-radius: var(--radius);
        padding: 18px 20px;
        margin-bottom: 14px;
      }
      .alert-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .alert-time {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-100);
      }
      .alert-coords {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--primary-400);
        text-decoration: none;
        margin-top: 2px;
      }
      .alert-coords:hover { text-decoration: underline; }
      .notifications {
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .no-notifications { margin: 0; font-size: 13px; color: var(--text-500); }
      .notification-row {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
      }
      .channel-tag {
        flex-shrink: 0;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        padding: 3px 8px;
        border-radius: 999px;
      }
      .channel-email { background: rgba(234, 32, 82, 0.14); color: var(--primary-400); }
      .channel-telegram { background: rgba(34, 158, 217, 0.14); color: #229ed9; }
      .contact-name { flex: 1; color: var(--text-100); }
      .view-status { font-size: 12px; white-space: nowrap; }
      .view-status.viewed { color: #22c55e; }
      .view-status.pending { color: var(--text-500); }

      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="brand">
        <span class="brand-mark">SOS</span>
        <span class="brand-name">PANIC SWITCH</span>
      </div>

      <div id="login-view">
        <div class="card">
          <h1>Alert Dashboard</h1>
          <p class="subtitle">Log in with your Panic Switch app account</p>
          <p id="login-error" class="error" hidden></p>
          <form id="login-form">
            <div class="field">
              <label>Email</label>
              <input type="email" name="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label>Password</label>
              <input type="password" name="password" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn">Log In</button>
          </form>
        </div>
      </div>

      <div id="dashboard-view" hidden>
        <div class="dash-header">
          <h1>Your Alerts</h1>
          <button id="logout-btn" class="btn-outline" type="button">Log Out</button>
        </div>
        <div id="alerts-list"></div>
      </div>
    </div>

    <script>
      let token = sessionStorage.getItem("ps_token");

      const loginView = document.getElementById("login-view");
      const dashView = document.getElementById("dashboard-view");
      const loginForm = document.getElementById("login-form");
      const loginError = document.getElementById("login-error");
      const alertsList = document.getElementById("alerts-list");
      const logoutBtn = document.getElementById("logout-btn");

      function escapeHtml(value) {
        const div = document.createElement("div");
        div.textContent = value ?? "";
        return div.innerHTML;
      }

      function showDashboard() {
        loginView.hidden = true;
        dashView.hidden = false;
        loadAlerts();
      }

      function showLogin(message) {
        sessionStorage.removeItem("ps_token");
        token = null;
        loginView.hidden = false;
        dashView.hidden = true;
        loginError.hidden = !message;
        if (message) loginError.textContent = message;
      }

      async function api(path, options = {}) {
        const headers = { "Content-Type": "application/json", ...(options.headers || {}) };
        if (token) headers["Authorization"] = `Bearer ${token}`;
        const response = await fetch(path, { ...options, headers });
        if (response.status === 401) {
          showLogin("Your session expired. Log in again.");
          throw new Error("unauthorized");
        }
        if (!response.ok) {
          const body = await response.json().catch(() => ({}));
          throw new Error(typeof body.detail === "string" ? body.detail : "Something went wrong.");
        }
        return response.status === 204 ? null : response.json();
      }

      function channelLabel(channel) {
        return channel === "telegram" ? "Telegram" : "Email";
      }

      async function loadAlerts() {
        alertsList.innerHTML = `<p class="empty">Loading...</p>`;
        try {
          const alerts = await api("/alerts");
          if (alerts.length === 0) {
            alertsList.innerHTML = `<p class="empty">No alerts have been triggered yet.</p>`;
            return;
          }
          alertsList.innerHTML = alerts
            .map(
              (alert) => `
            <div class="alert-card">
              <div class="alert-header">
                <span class="alert-time">${escapeHtml(alert.created_at)}</span>
              </div>
              <a class="alert-coords" href="https://www.google.com/maps?q=${alert.latitude},${alert.longitude}" target="_blank" rel="noopener">${alert.latitude}, ${alert.longitude}</a>
              <div class="notifications">
                ${
                  alert.notifications.length === 0
                    ? `<p class="no-notifications">No confirmed contacts were notified for this alert.</p>`
                    : alert.notifications
                        .map(
                          (notification) => `
                      <div class="notification-row">
                        <span class="channel-tag channel-${notification.channel}">${channelLabel(notification.channel)}</span>
                        <span class="contact-name">${escapeHtml(notification.contact_name)}</span>
                        <span class="view-status ${notification.viewed_at ? "viewed" : "pending"}">
                          ${notification.viewed_at ? `Seen ${escapeHtml(notification.viewed_at)}` : "Not seen yet"}
                        </span>
                      </div>
                    `
                        )
                        .join("")
                }
              </div>
            </div>
          `
            )
            .join("");
        } catch (error) {
          if (error.message !== "unauthorized") {
            alertsList.innerHTML = `<p class="empty">${escapeHtml(error.message)}</p>`;
          }
        }
      }

      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        loginError.hidden = true;
        const data = Object.fromEntries(new FormData(loginForm));
        try {
          const result = await api("/auth/login", { method: "POST", body: JSON.stringify(data) });
          token = result.access_token;
          sessionStorage.setItem("ps_token", token);
          showDashboard();
        } catch (error) {
          loginError.textContent = error.message;
          loginError.hidden = false;
        }
      });

      logoutBtn.addEventListener("click", () => showLogin());

      if (token) {
        showDashboard();
      } else {
        showLogin();
      }
    </script>
  </body>
</html>
