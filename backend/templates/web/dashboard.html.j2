<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard — Panic Button</title>
    <link rel="icon" type="image/png" href="/static/img/favicon.png" />
    <link rel="stylesheet" href="/static/css/dashboard.css" />
  </head>
  <body>
    <div class="wrap">
      <div class="brand">
        <img class="brand-mark" src="/static/img/brand-mark.png" alt="" />
        <span class="brand-name">PANIC BUTTON</span>
      </div>

      <button id="settings-btn" class="settings-fab" type="button" aria-haspopup="dialog" aria-label="Settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z"/></svg>
      </button>

      <dialog id="settings-dialog" class="settings-dialog">
        <form method="dialog" class="settings-dialog-inner">
          <div class="settings-dialog-header">
            <h2>Settings</h2>
            <button type="submit" class="dialog-close" aria-label="Close">&#10005;</button>
          </div>
          <div class="settings-group">
            <span class="settings-label">Theme</span>
            <select id="theme-select" class="settings-select">
              <option value="auto">Auto</option>
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </div>
          <div class="settings-group">
            <span class="settings-label">Color</span>
            <div class="settings-swatches" id="color-swatches">
              <button type="button" class="settings-swatch" data-color="#ea2052" style="background:#ea2052" aria-label="#ea2052"></button>
              <button type="button" class="settings-swatch" data-color="#2563eb" style="background:#2563eb" aria-label="#2563eb"></button>
              <button type="button" class="settings-swatch" data-color="#16a34a" style="background:#16a34a" aria-label="#16a34a"></button>
              <button type="button" class="settings-swatch" data-color="#9333ea" style="background:#9333ea" aria-label="#9333ea"></button>
              <button type="button" class="settings-swatch" data-color="#f97316" style="background:#f97316" aria-label="#f97316"></button>
              <button type="button" class="settings-swatch" data-color="#0d9488" style="background:#0d9488" aria-label="#0d9488"></button>
              <label class="settings-swatch settings-swatch-custom" id="color-swatch-custom" title="Custom color">
                <input type="color" id="color-custom-input" value="#ea2052" />
              </label>
            </div>
          </div>
        </form>
      </dialog>

      <div id="login-view">
        <div class="card">
          <h1>Alert Dashboard</h1>
          <p class="subtitle">Log in with your Panic Button app account</p>
          <p id="login-error" class="error" hidden></p>
          <form id="login-form">
            <div class="field">
              <label>Email</label>
              <input type="email" name="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label>Password</label>
              <input type="password" name="password" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn">Log In</button>
          </form>
        </div>
      </div>

      <div id="dashboard-view" hidden>
        <div class="dash-header">
          <h1>Your Alerts</h1>
          <button id="logout-btn" class="btn-outline" type="button">Log Out</button>
        </div>
        <div id="alerts-list"></div>
      </div>
    </div>

    <footer class="dash-footer">
      <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
      <span class="dash-footer-sep">&middot;</span>
      <a href="https://keycodelogics.com/" target="_blank" rel="noopener">About us</a>
    </footer>

    <script src="/static/js/dashboard.js"></script>
  </body>
</html>
