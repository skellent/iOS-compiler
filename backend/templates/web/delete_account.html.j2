<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Delete your account — Panic Button</title>
    <meta name="description" content="Request permanent deletion of your Panic Button account and all associated data. We email you a confirmation link before anything is removed." />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a397c" />
    <link rel="canonical" href="{{ base_url }}/delete-account" />
    <link rel="icon" type="image/png" href="/static/img/panic-button-icon.png" />
    <link rel="stylesheet" href="/static/css/landing.css" />
    <link rel="stylesheet" href="/static/css/delete_account.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">
          <img class="brand-title" src="/static/img/panic-button-title.png" alt="Panic Button" />
        </a>
        <a class="dashboard-link" href="/">Home</a>
      </div>
    </header>

    <main class="delete-page">
      <section class="delete-card" aria-labelledby="delete-title">
        <div class="delete-icon" aria-hidden="true">!</div>
        <p class="eyebrow">Account management</p>
        <h1 id="delete-title">Delete your account</h1>
        <p class="message">Request permanent deletion of your Panic Button account and associated data.</p>

        <p class="del-warn"><strong>This action cannot be undone.</strong> It removes your profile, emergency contacts and alert history. To protect your account, we’ll first send a confirmation link to your email.</p>

        <form class="del-form" id="del-form" novalidate>
          <div>
            <label for="email">Account email</label>
            <input type="email" id="email" autocomplete="email" inputmode="email" required />
          </div>
          <p class="del-hint">Enter the email address you use to sign in.</p>
          <button type="submit" class="del-btn" id="submit-btn">Send deletion link</button>
          <p class="del-msg" id="msg" aria-live="polite"></p>
        </form>

        <a class="back-home" href="/">← Return home</a>
      </section>
    </main>

    <footer class="site-footer delete-footer">
      <img class="footer-brand" src="/static/img/panic-button-title.png" alt="Panic Button" />
      <p class="footnote">ACTIVE PROTECTION · INSTANT RESPONSE</p>
      <a class="footer-link" href="/privacy">Privacy Policy</a>
    </footer>

    <script>
      (function () {
        var form = document.getElementById("del-form");
        var msg = document.getElementById("msg");
        var btn = document.getElementById("submit-btn");

        form.addEventListener("submit", async function (event) {
          event.preventDefault();
          var email = document.getElementById("email").value.trim();
          msg.className = "del-msg";
          msg.textContent = "";

          if (!email || email.indexOf("@") === -1) {
            msg.className = "del-msg error";
            msg.textContent = "Please enter a valid email address.";
            return;
          }

          btn.disabled = true;
          try {
            var response = await fetch("/auth/account-deletion/request", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email: email }),
            });
            if (response.ok) {
              form.reset();
              msg.className = "del-msg ok";
              msg.textContent = "If an account exists for that email, we've sent a confirmation link. Check your inbox to finish deleting your account.";
              btn.textContent = "Link sent";
            } else if (response.status === 429) {
              msg.className = "del-msg error";
              msg.textContent = "Too many requests. Please wait a little while and try again.";
              btn.disabled = false;
            } else {
              msg.className = "del-msg error";
              msg.textContent = "Something went wrong. Please try again.";
              btn.disabled = false;
            }
          } catch (err) {
            msg.className = "del-msg error";
            msg.textContent = "Something went wrong. Please try again.";
            btn.disabled = false;
          }
        });
      })();
    </script>
  </body>
</html>
