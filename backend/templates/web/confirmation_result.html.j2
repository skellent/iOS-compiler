<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ "Contact confirmed" if success else "Confirmation failed" }} — PanicSwitch</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
        background: linear-gradient(160deg, #7f1d1d 0%, #b91c1c 45%, #dc2626 100%);
      }
      .card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        padding: 40px 36px;
        text-align: center;
      }
      .icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 24px auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: {{ "#dc2626" if success else "#7f1d1d" }};
      }
      .icon svg { width: 36px; height: 36px; }
      h1 {
        margin: 0 0 12px 0;
        font-size: 22px;
        color: #18181b;
      }
      p.message {
        margin: 0 0 28px 0;
        font-size: 15px;
        line-height: 1.6;
        color: #52525b;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #dc2626;
      }
      .footnote {
        margin-top: 24px;
        font-size: 11px;
        color: #a1a1aa;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="icon">
        {% if success %}
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 12 9 18 20 6"></polyline>
        </svg>
        {% else %}
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
        {% endif %}
      </div>

      <h1>{{ "You're confirmed!" if success else "This didn't work" }}</h1>
      <p class="message">{{ message }}</p>

      <span class="brand">🆘 PANICSWITCH</span>
      <p class="footnote">Emergency alert system</p>
    </div>
  </body>
</html>
