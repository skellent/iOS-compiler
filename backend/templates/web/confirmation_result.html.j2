<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ "Contact confirmed" if success else "Confirmation failed" }} — Panic Button</title>
    <link rel="icon" type="image/png" href="/static/img/favicon.png" />
    <link rel="stylesheet" href="/static/css/confirmation_result.css" />
  </head>
  <body>
    <div class="card">
      <div class="icon {{ "icon-success" if success else "icon-error" }}">
        {% if success %}
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 12 9 18 20 6"></polyline>
        </svg>
        {% else %}
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
        {% endif %}
      </div>

      <h1>{{ "You're confirmed!" if success else "This didn't work" }}</h1>
      <p class="message">{{ message }}</p>

      <span class="brand">PANIC BUTTON</span>
      <p class="footnote">Emergency alert system</p>
    </div>
  </body>
</html>
