<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="0; url={{ deep_link }}" />
    <title>Account confirmed — Panic Switch</title>
    <link rel="icon" type="image/png" href="data:image/png;base64," />
    <style>
      :root { --primario: #EA2052; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
        background: var(--primario);
      }
      .card {
        width: 100%;
        max-width: 440px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        padding: 40px 36px;
        text-align: center;
        animation: card-in 0.5s ease-out both;
      }
      .icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 24px auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primario);
        animation: pop-in 0.45s 0.15s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      }
      .icon svg { width: 36px; height: 36px; }
      .icon svg polyline {
        stroke-dasharray: 26;
        stroke-dashoffset: 26;
        animation: draw 0.35s 0.45s ease-out forwards;
      }
      h1 {
        margin: 0 0 12px 0;
        font-size: 22px;
        color: #18181b;
      }
      p.message {
        margin: 0 0 28px 0;
        font-size: 15px;
        line-height: 1.6;
        color: #52525b;
      }
      .button {
        display: inline-block;
        padding: 14px 32px;
        border-radius: 8px;
        background: var(--primario);
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        text-decoration: none;
      }
      .brand {
        display: block;
        margin-top: 28px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--primario);
      }
      .footnote {
        margin-top: 8px;
        font-size: 11px;
        color: #a1a1aa;
      }
      @keyframes card-in {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes pop-in {
        from { opacity: 0; transform: scale(0); }
        to   { opacity: 1; transform: scale(1); }
      }
      @keyframes draw {
        to { stroke-dashoffset: 0; }
      }
    </style>
    <script>
      window.location.replace("{{ deep_link }}");
    </script>
  </head>
  <body>
    <div class="card">
      <div class="icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 12 9 18 20 6"></polyline>
        </svg>
      </div>

      <h1>You're confirmed!</h1>
      <p class="message">Taking you back to the Panic Switch app now.</p>

      <a class="button" href="{{ deep_link }}">Open Panic Switch</a>

      <span class="brand">PANIC SWITCH</span>
      <p class="footnote">Emergency alert system</p>
    </div>
  </body>
</html>
