.directory

# app/ is now tracked directly (its own .gitignore, plus
# app/android/.gitignore and app/ios/.gitignore, handle build artifacts
# under app/). These extra rules are a second line of defense in case a
# broad `git add` runs before those nested files are on disk (e.g. right
# after a fresh checkout).
app/node_modules/
app/www/js/
app/bun.lock
app/.env
app/android/.gradle/
app/android/**/build/
app/android/.idea/caches/
app/android/.idea/workspace.xml
app/ios/App/build/
app/ios/App/Pods/
app/ios/App/output/
app/ios/DerivedData/
app/ios/xcuserdata/
